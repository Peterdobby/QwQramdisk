#!/bin/bash
# iOS 9: mount Data normally, then patch its matching /mnt1 keybagd.
# The bundled patcher selects a reviewed layout by the actual source SHA-256.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin

say() { echo "[*] [mount-ios9-stage] $*"; }
fail() { say "ERROR: $*" >&2; exit 1; }

[[ -f /private/var/tmp/ios9-profile.txt ]] || fail 'wrong ramdisk profile'
profile="$(/bin/cat /private/var/tmp/ios9-profile.txt)"
[[ "$profile" =~ ^[a-z][a-z0-9]*-13[A-Z][0-9]+$ ]] || fail 'invalid iOS 9 profile marker'
build="${profile##*-}"
# ASP must be writable before System/SEP/Data activity starts. The mode is
# selected for iOS 9 A7/A8/A8X profiles; A9 profiles use the stock path.
if [[ -f /private/var/tmp/ios9-storage-mode.txt ]]; then
    storage_mode="$(/bin/cat /private/var/tmp/ios9-storage-mode.txt)"
    case "$storage_mode" in
        asp-writable)
            /usr/local/libexec/ensure-asp-writable-ios9 \
                || fail 'ASP storage write setup failed; restart the matching ramdisk' ;;
        stock) ;;
        *) fail 'invalid iOS 9 storage setup mode' ;;
    esac
fi
[[ -b /dev/disk0s1s1 && -b /dev/disk0s1s2 ]] || fail 'missing System or Data volume'

mounts="$(/sbin/mount)"
if [[ "$mounts" != *'/dev/disk0s1s1 on /mnt1 '* ]]; then
    if ! /sbin/mount_hfs -o rdonly /dev/disk0s1s1 /mnt1; then
        # A System volume requiring journal replay cannot mount read-only.
        # Keep System read-only and retry without replaying its journal.
        say 'retrying read-only System mount without journal replay'
        /sbin/mount_hfs -j -o rdonly /dev/disk0s1s1 /mnt1 \
            || fail 'System mount failed'
    fi
fi
mounts="$(/sbin/mount)"
[[ "$mounts" == *'/dev/disk0s1s1 on /mnt1 '* ]] \
    || fail 'System mount verification failed'
[[ -f /mnt1/System/Library/CoreServices/SystemVersion.plist ]] \
    || fail 'SystemVersion.plist missing'
system_version="$(/bin/cat /mnt1/System/Library/CoreServices/SystemVersion.plist)"
[[ "$system_version" == *"<string>$build</string>"* ]] \
    || fail "mounted system is not build $build"

[[ -f /mnt1/usr/libexec/keybagd ]] || fail 'matching system keybagd missing'
[[ -x /usr/local/libexec/patch-keybagd-ios9 ]] || fail 'patcher missing'
/usr/local/libexec/patch-keybagd-ios9 --check /mnt1/usr/libexec/keybagd \
    || fail 'unknown or invalid keybagd binary; analyze and register its exact hash first'

if ! /mnt1/usr/libexec/seputil --ping >/dev/null 2>&1; then
    /mnt1/usr/libexec/seputil --load \
        /mnt1/usr/standalone/firmware/sep-firmware.img4 \
        || fail 'SEP firmware load failed'
fi
sep_ready=0
for attempt in 1 2 3 4 5; do
    if /mnt1/usr/libexec/seputil --ping >/dev/null 2>&1; then sep_ready=1; break; fi
    # Some bundled iRam utilities are rejected on 13D15. Keep the bounded
    # readiness delay working even when sleep cannot execute.
    if ! /bin/sleep 1; then
        deadline=$((SECONDS + 1))
        while (( SECONDS < deadline )); do :; done
    fi
done
[[ "$sep_ready" -eq 1 ]] || fail 'SEP did not become ready'

mounts="$(/sbin/mount)"
if [[ "$mounts" != *'/dev/disk0s1s2 on /mnt2 '* ]]; then
    /sbin/mount_hfs -o rw /dev/disk0s1s2 /mnt2 \
        || fail 'direct journaled Data RW mount failed'
fi
mount_line="$(/sbin/mount)"
case "$mount_line" in
    *'/dev/disk0s1s2 on /mnt2 '*)
        mount_line="/dev/disk0s1s2 on /mnt2 ${mount_line#*'/dev/disk0s1s2 on /mnt2 '}"
        mount_line="${mount_line%%$'\n'*}" ;;
    *) mount_line= ;;
esac
[[ "$mount_line" == *journaled* && "$mount_line" != *read-only* ]] \
    || fail 'Data is not journaled RW'

[[ -f /mnt1/usr/libexec/keybagd ]] || fail 'matching system keybagd missing'
/bin/mkdir -p /mnt2/tmp || fail 'Data temporary directory unavailable'
[[ -x /usr/local/libexec/patch-keybagd-ios9 ]] || fail 'patcher missing'
/usr/local/libexec/patch-keybagd-ios9 \
    /mnt1/usr/libexec/keybagd /mnt2/tmp/qwqramdisk-keybagd \
    || fail 'keybagd patch failed'
say 'Data mounted journaled RW; /mnt1 keybagd copied and patched into /mnt2/tmp'
